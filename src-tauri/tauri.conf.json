{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "并行工作台",
  "version": "0.1.0",
  "identifier": "com.parallelworkbench.dev",
  "build": {
    "beforeDevCommand": "",
    "devUrl": "http://localhost:8731",
    "beforeBuildCommand": "",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "并行工作台 · ParallelDev Workbench",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "center": true,
        "devtools": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {}
}
