{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "并行工作台默认权限：核心 + 对话框 + Shell 打开文件",
  "windows": ["main", "*"],
  "permissions": [
    "core:default",
    "dialog:default",
    "fs:default",
    "fs:allow-read-text-file",
    "fs:allow-write-text-file",
    {
      "identifier": "shell:allow-open",
      "allow": [{ "path": "**" }]
    },
    "shell:allow-spawn"
  ]
}
